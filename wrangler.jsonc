// Root-level Wrangler config so Workers Builds' default deploy command
// (`npx wrangler deploy` executed at the repo root) deploys the REAL worker
// instead of triggering wrangler's automatic configuration, which previously
// overwrote bikeroutes-api with a static-assets-only worker.
//
// This mirrors worker/wrangler.jsonc with paths adjusted to be relative to
// the repo root. KEEP THE TWO FILES IN SYNC. If the Workers Builds deploy
// command is ever changed to `npm run deploy` (which cds into worker/), this
// file can be deleted.
{
	"name": "bikeroutes-api",
	"main": "worker/src/index.ts",
	"tsconfig": "worker/tsconfig.json",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	// ─── Custom Domains ───────────────────────────────────
	"workers_dev": true,
	"routes": [
		{ "pattern": "bikeroutes.org", "custom_domain": true },
		{ "pattern": "www.bikeroutes.org", "custom_domain": true }
	],
	// ─── Triggers ─────────────────────────────────────────
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	// ─── D1 Database ──────────────────────────────────────
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bikeroutes-db",
			"database_id": "a62046a7-4193-49c1-910f-9e7dbc209009",
			"migrations_dir": "worker/migrations"
		}
	],
	// ─── KV Namespaces ────────────────────────────────────
	"kv_namespaces": [
		{
			"binding": "ROUTE_CACHE",
			"id": "f5f46f5bfc1d4abfb6c878d9a1730b91"
		},
		{
			"binding": "RATE_LIMITS",
			"id": "b7c39ff11ddc4ad29504abf156d114ba"
		},
		{
			"binding": "SESSIONS",
			"id": "d21074b7bec94e32ae2bb76278a09e49"
		}
	],
	// ─── Static Assets ────────────────────────────────────
	// Frontend SPA — Vite builds into worker/public/
	"assets": {
		"directory": "./worker/public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// ─── R2 Buckets ───────────────────────────────────────
	"r2_buckets": [
		{
			"binding": "R2_ASSETS",
			"bucket_name": "bikeroutes-assets"
		},
		{
			"binding": "TILES",
			"bucket_name": "bikeroutes-tiles"
		}
	],
	// ─── Vectorize ────────────────────────────────────────
	"vectorize": [
		{
			"binding": "TRAIL_SEARCH",
			"index_name": "bikeroutes-trails"
		}
	],
	// ─── AI (Workers AI) ──────────────────────────────────
	"ai": {
		"binding": "AI"
	},
	// ─── Durable Objects ──────────────────────────────────
	"durable_objects": {
		"bindings": [
			{
				"class_name": "POIStore",
				"name": "POI_STORE"
			},
			{
				"class_name": "RouteSession",
				"name": "ROUTE_SESSION"
			},
			{
				"class_name": "ValhallaContainer",
				"name": "VALHALLA"
			}
		]
	},
	// ─── Containers ───────────────────────────────────────
	"containers": [
		{
			"class_name": "ValhallaContainer",
			"image": "./worker/Dockerfile.valhalla",
			"max_instances": 3
		}
	],
	// ─── Migrations ───────────────────────────────────────
	"migrations": [
		{
			"new_sqlite_classes": [
				"POIStore",
				"RouteSession",
				"ValhallaContainer"
			],
			"tag": "v1"
		}
	]
}
