/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://nominatim.openstreetmap.org; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; img-src 'self' data: https://*.basemaps.cartocdn.com https://tile.openstreetmap.org https://nominatim.openstreetmap.org https://brouter.de; connect-src 'self' https://nominatim.openstreetmap.org https://brouter.de;

# Cache-control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable
