{
	"name": "bikeroutes-api",
	"description": "BikeRoutes.org API — Cloudflare Workers backend",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --containers-rollout=none",
		"deploy:container": "wrangler deploy",
		"build": "tsc",
		"cf-typegen": "wrangler types",
		"check": "tsc && wrangler deploy --dry-run --containers-rollout=none",
		"check:container": "tsc && wrangler deploy --dry-run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"predeploy": "npm run db:migrate:remote"
	},
	"dependencies": {
		"@cloudflare/containers": "^0.1.0",
		"hono": "^4.0.0",
		"pmtiles": "^4.4.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"typescript": "^5.9.0",
		"wrangler": "^4.56.0"
	}
}
