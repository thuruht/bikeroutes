{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"lib": ["ES2022"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"outDir": "dist",
		"rootDir": "src",
		"resolveJsonModule": true,
		"noEmit": true,
		"jsx": "react-jsx"
	},
	"include": ["src/**/*", "worker-configuration.d.ts"]
}
