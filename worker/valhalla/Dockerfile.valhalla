# Valhalla container baked with Midwest tiles.
# The CI pipeline copies valhalla.json and tiles.tar here before wrangler deploy.
FROM ghcr.io/valhalla/valhalla:latest

ENV LD_LIBRARY_PATH=/usr/local/lib
ENV VALHALLA_CONFIG=/data/valhalla/valhalla.json

COPY valhalla.json /data/valhalla/valhalla.json
COPY tiles.tar /data/valhalla/tiles.tar

EXPOSE 8002

CMD ["valhalla_service", "/data/valhalla/valhalla.json", "1"]
